# Supabase
# Pegue em: Supabase Dashboard -> Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://rximtawdguljuwiektgx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...sua_anon_key_aqui

# (Opcional) Service role - apenas para queries server-side mais privilegiadas.
# Se vazio, o app usa NEXT_PUBLIC_SUPABASE_ANON_KEY em SSR.
# NUNCA exponha SERVICE_ROLE no client — não use NEXT_PUBLIC_ no prefixo.
# SUPABASE_SERVICE_ROLE_KEY=eyJ...

# RD Station — usado só por /api/rd/contato, que resolve o uuid do contato para
# levar do lead no dash direto ao perfil no RD. Sem estas variáveis o botão
# continua funcionando: cai na busca por e-mail no RD em vez do perfil.
#
# Basta UM dos dois arranjos. O access token do RD expira em 24h, então em
# produção use o trio de OAuth2.
# RD_ACCESS_TOKEN=
# RD_CLIENT_ID=
# RD_CLIENT_SECRET=
# RD_REFRESH_TOKEN=
#
# Base do perfil de contato no app do RD. O caminho já mudou entre versões
# (/leads/{uuid} e /contatos/{uuid}) — ajuste aqui em vez de mexer no código.
# RD_APP_CONTACT_URL=https://app.rdstation.com.br/contatos

# Segredo do endpoint de revalidação (/api/revalidate).
# Quem chama: o job de engajamento de 3 dias e o cron diário da Vercel.
# Gere um valor aleatório longo, ex.: openssl rand -hex 32
CRON_SECRET=troque_por_um_segredo_aleatorio
